# PostgreSQL connection used by Prisma's pooled runtime client.
POSTGRES_PRISMA_URL="postgresql://username:password@hostname:port/database?sslmode=require"

# Direct PostgreSQL connection used by Prisma migrations.
POSTGRES_URL_NON_POOLING="postgresql://username:password@hostname:port/database?sslmode=require"

# Password for the /admin login.
ADMIN_PASSWORD="change-this-in-production"

# Long random secret used to sign admin sessions.
AUTH_SECRET="generate-a-long-random-string"
