# Postgres (Netlify Database) — the only database for this app.
# NETLIFY_DATABASE_URL / related vars are injected by `netlify dev` and on Netlify deploy.
# Do not commit connection strings. Run: npx netlify dev:exec -- npm run db:migrate && npm run db:seed

# Management login (required in production; set both in Netlify → Environment variables).
# AUTH_SECRET: a long random string. ADMIN_SETUP_CODE: one-time code to create the first owner.
AUTH_SECRET=
ADMIN_SETUP_CODE=
